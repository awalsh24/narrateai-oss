# ── Backend API ───────────────────────────────────────────────
# Base URL of the NarrateAI backend (src/server.js). Required — points
# the SPA at the API it should call. Use http://localhost:3000 for local
# dev against `npm start` / docker compose; your deployed backend's URL
# in production.
VITE_API_URL=http://localhost:3000

# ── PostHog analytics (optional) ──────────────────────────────
# Product analytics. Optional — if unset, posthog-js is initialized with
# an empty token and effectively no-ops.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Cloudflare R2 (optional, dev preview only) ────────────────
# Public base URL of the R2 bucket (same value as the backend's
# R2_PUBLIC_URL). Optional — only used by a hidden ?preview=completed
# dev route to preview the completed-video UI without running a real job.
VITE_R2_PUBLIC_URL=https://pub-xxxx.r2.dev
