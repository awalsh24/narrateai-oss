# ── OpenAI ────────────────────────────────────────────────────
# Used for script generation (chat completions) and narration (TTS).
# Required. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Stock Footage ─────────────────────────────────────────────
# Fallback footage sources when LIBRARY_PATH (below) is not set or a clip
# isn't found locally. Required unless you only ever use a local library.
PEXELS_API_KEY=...
PIXABAY_API_KEY=...

# ── Redis (job queue) ─────────────────────────────────────────
# BullMQ connection string for the video-generation queue shared by the
# API server and the worker process. Optional — defaults to a local Redis
# on the standard port if unset.
REDIS_URL=redis://127.0.0.1:6379

# ── Cloudflare R2 (video storage) ─────────────────────────────
# Required. Finished videos are uploaded here and served publicly from
# R2_PUBLIC_URL. Create a bucket + API token at https://dash.cloudflare.com
R2_ACCOUNT_ID=...
R2_ACCESS_KEY=...
R2_SECRET_KEY=...
R2_BUCKET_NAME=narrateai-videos
# Public base URL for the bucket above (its own r2.dev subdomain, or a
# custom domain if you've mapped one). Optional — if unset it's derived
# from R2_ACCOUNT_ID as https://pub-<R2_ACCOUNT_ID>.r2.dev
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Supabase (data storage only) ──────────────────────────────
# Required. Used purely as a Postgres+PostgREST data layer for video
# records — auth is local single-user (see below), not Supabase Auth.
# Point this at your own Supabase project, or at the local PostgREST
# stack docker-compose.yml brings up (see that file's comments).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# ── Local single-user mode ─────────────────────────────────────
# Required. There is no signup/login — every request is attributed to
# this one fixed user. LOCAL_USER_ID can be any UUID; it does not need
# to correspond to a real Supabase Auth account.
LOCAL_USER_ID=00000000-0000-0000-0000-000000000001
LOCAL_USER_EMAIL=you@example.com

# ── App server ──────────────────────────────────────────────────
# Port the Express API server listens on. Optional — defaults to 3000.
PORT=3000
# Comma-separated list of origins allowed to call the API (CORS). Optional
# — defaults to the local Vite dev server only. Add your deployed
# frontend's origin(s) here in production.
ALLOWED_ORIGINS=http://localhost:5173

# ── Local clip library (optional) ────────────────────────────
# Absolute path to a local folder of stock video clips. If unset, footage
# is always fetched from Pexels/Pixabay instead.
LIBRARY_PATH=/Users/you/Downloads/narrateai-clips

# ── ffmpeg/ffprobe (optional) ─────────────────────────────────
# Path to the ffprobe binary. Optional — defaults to "ffprobe" on PATH
# (already satisfied by ffmpeg-static in node_modules for most setups).
FFPROBE_PATH=ffprobe

# ── scripts/test-e2e.js (optional, dev tool only) ─────────────
# Backend URL the E2E smoke-test script hits. Optional — defaults to
# http://localhost:3000; not read by the app itself.
BACKEND_URL=http://localhost:3000
